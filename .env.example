# Mode: bot (Telegram) atau tui (terminal)
CFM_MODE=bot

# Telegram: token dari @BotFather, dan user ID yang boleh memakai bot (pisahkan dengan koma)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Cloudflare API token (wajib untuk mode bot)
CFM_API_TOKEN=
# Account ID Cloudflare, dibutuhkan untuk fitur Workers
CFM_ACCOUNT_ID=
CFM_ACCOUNT_NAME=default

CFM_CONFIG_PATH=
CFM_LOG_LEVEL=info
